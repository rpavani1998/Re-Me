# Copy this file to backend/.env. Run the API from backend/.
# Codex development authentication is separate from these runtime credentials.

# Database connection. Users sign in with email/password or Google.
DATABASE_URL=postgresql+psycopg://reme:reme@localhost:5432/reme
# Optional legacy API access for scripts; not needed for dashboard or extension login.
API_TOKEN=
USER_ID=demo-user
APP_ENV=development

# true = deterministic demo, NO paid AI requests. false = selected live provider.
DEMO_MODE=true

# Choose openai OR openrouter. Only the chosen provider's key is required.
LLM_PROVIDER=openrouter

# Required only for LLM_PROVIDER=openrouter. Get a key: https://openrouter.ai/settings/keys
# Used for BOTH structured understanding/reranking AND embeddings.
OPENROUTER_API_KEY=
# Choose an endpoint with structured_outputs support.
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Required only for LLM_PROVIDER=openai. Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# URLs are configuration, not credentials.
ALLOWED_ORIGINS=["http://localhost:3000"]
PUBLIC_API_URL=http://localhost:8000
# Optional Trigger.dev deadline wake-ups: secret API key from project dashboard -> API Keys.
# Backend uses the API key to schedule tasks and sign per-reminder callbacks.
# PUBLIC_API_URL must be reachable HTTPS for cloud reminders. No callback token setup needed.
TRIGGER_SECRET_KEY=

# Optional later features. Leave blank for the core capture + recall flow.
EXA_API_KEY=

# Optional Continue with Google: Web OAuth client ID (not a client secret).
# Authorize http://localhost:3000 as a JavaScript origin in Google Cloud.
GOOGLE_CLIENT_ID=

# API key for your own Ambiguous workspace (never the shared demo workspace).
AMBIGUOUS_API_KEY=

# Bind the workspace integration to one Re:Me account.
AMBIGUOUS_OWNER_EMAIL=
AMBIGUOUS_CALENDAR_ID=
